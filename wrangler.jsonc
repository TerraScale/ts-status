{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ts-status",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "routes": [{ "pattern": "status.terrascale.tech", "custom_domain": true }],
  // Keeps the probe coordinator armed and rolls samples up (src/probe/rollup.ts).
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "STATUS_DB",
      "database_name": "ts-status",
      "database_id": "c2eca5bc-6045-4983-941a-4e01e4e0c749",
    },
  ],
  // Cloudflare Email Sending for subscription mail (src/notify/outbox.ts).
  "send_email": [{ "name": "EMAIL", "remote": true }],
  // Runs a probe round every 30 seconds (src/probe/coordinator.ts).
  "durable_objects": { "bindings": [{ "name": "COORDINATOR", "class_name": "Coordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Coordinator"] }],
  "vars": { "PUBLIC_ORIGIN": "https://status.terrascale.tech" },
  // Subscription requests and admin sign-in attempts per client IP
  // (src/notify/subscribe.ts, src/admin/index.ts).
  "ratelimits": [
    { "name": "SUBSCRIBE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "ADMIN_LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
  ],
  // The vantage Workers (src/probe/vantages.ts), built from vite.config.ts.
  "services": [
    { "binding": "VANTAGE_SFO", "service": "ts-status-vantage-sfo" },
    { "binding": "VANTAGE_GRU", "service": "ts-status-vantage-gru" },
    { "binding": "VANTAGE_FRA", "service": "ts-status-vantage-fra" },
    { "binding": "VANTAGE_NRT", "service": "ts-status-vantage-nrt" },
  ],
}
