{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ts-status",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "routes": [{ "pattern": "status.terrascale.tech", "custom_domain": true }],
  // Probes every region's clusters (src/probe.ts).
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "STATUS_DB",
      "database_name": "ts-status-db",
      "database_id": "8a72dd69-2136-4398-8d70-92c0c2dade5a",
    },
  ],
}
