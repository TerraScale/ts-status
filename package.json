{
  "name": "ts-status",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "tsc --noEmit",
    "lint": "vp lint && vp fmt --check",
    "test": "vitest run",
    "deploy": "npm run build && npm run db:bootstrap:remote && wrangler deploy",
    "db:bootstrap:local": "wrangler d1 execute ts-status --local --file schema.sql",
    "db:bootstrap:remote": "wrangler d1 execute ts-status --remote --file schema.sql"
  },
  "dependencies": {
    "@terrascale/sdk": "0.0.3",
    "ulid": "3.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@12.0.2",
  "overrides": {
    "@cloudflare/vite-plugin": {
      "vite": {
        ".": "8.3.3",
        "rolldown": "1.2.11"
      }
    }
  }
}
