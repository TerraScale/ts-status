{
  "name": "ts-status",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "tsc --noEmit",
    "lint": "vp lint && vp fmt --check",
    "test": "vitest run",
    "deploy": "npm run build && wrangler d1 migrations apply ts-status-db --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ts-status-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ts-status-db --remote"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@12.0.2"
}
