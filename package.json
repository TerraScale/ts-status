{
  "name": "ts-status",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "tsc --noEmit",
    "lint": "vp lint && vp fmt --check",
    "test": "vitest run",
    "deploy": "npm run build && npm run db:bootstrap:remote && npm run deploy:vantages && wrangler deploy",
    "deploy:vantages": "for config in dist/ts_status_vantage_*/wrangler.json; do wrangler deploy -c \"$config\" || exit 1; done",
    "db:bootstrap:local": "wrangler d1 execute ts-status-db --local --file schema.sql",
    "db:bootstrap:remote": "wrangler d1 execute ts-status-db --remote --file schema.sql"
  },
  "dependencies": {
    "@terrascale/sdk": "0.0.2",
    "ulid": "3.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@12.0.2"
}
